{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StationVisionProfile",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema", "schema_version", "station_id", "cameras"],
  "properties": {
    "schema": {"const": "StationVisionProfile"},
    "schema_version": {"type": "string"},
    "profile_id": {"type": "string"},
    "station_id": {"type": "string"},
    "line_id": {"type": "string"},
    "recipe_id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["camera_id", "role"],
        "properties": {
          "slot": {"type": "integer"},
          "camera_id": {"type": "string"},
          "role": {"type": "string", "enum": ["top", "side", "bottom", "stf", "completeness", "other"]},
          "enabled": {"type": "boolean"},
          "lens_notes": {"type": "string"},
          "fov_notes": {"type": "string"},
          "working_distance_mm": {"type": ["number", "null"]},
          "lighting": {"type": "object"},
          "capture": {"type": "object"}
        }
      }
    },
    "checklist": {"type": "object"},
    "acceptance": {"type": "object"}
  }
}
