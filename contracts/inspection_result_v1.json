{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InspectionResult v1.2",
  "version": "1.2.0",
  "type": "object",
  "required": ["inspection_id", "frame", "inference", "decision"],
  "properties": {
    "inspection_id": {"type": "string"},
    "decision": {"type": "string", "enum": ["green", "amber", "red"]},
    "decision_policy": {"type": "string", "description": "Aggregation policy, e.g. worst_view"},
    "camera_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "string"}
    },
    "view_count": {"type": "integer", "minimum": 1, "maximum": 4},
    "worst_view_camera_id": {"type": "string"},
    "frame": {
      "type": "object",
      "description": "Worst-view projection (compat)",
      "required": ["frame_id", "camera_id", "recipe_id", "captured_at", "image_uri"],
      "properties": {
        "frame_id": {"type": "string"},
        "camera_id": {"type": "string"},
        "recipe_id": {"type": "string"},
        "captured_at": {"type": "string", "format": "date-time"},
        "image_uri": {"type": "string"},
        "source": {"type": ["string", "null"]}
      }
    },
    "inference": {
      "type": "object",
      "description": "Worst-view projection (compat)",
      "required": ["anomaly_score", "status", "heatmap_uri", "model_version"],
      "properties": {
        "anomaly_score": {"type": "number"},
        "status": {"type": "string"},
        "heatmap_uri": {"type": "string"},
        "model_version": {"type": "string"}
      }
    },
    "heatmap": {"type": "object"},
    "views": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["camera_id", "frame", "inference", "decision"],
        "properties": {
          "camera_id": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "frame": {"type": "object"},
          "inference": {"type": "object"},
          "decision": {"type": "string"},
          "heatmap": {"type": "object"}
        }
      }
    },
    "trend_warning": {"type": "boolean"},
    "trend_severity": {"type": "string"},
    "trend_reason": {"type": ["string", "null"]},
    "by_camera": {"type": "array"},
    "drifting_camera_id": {"type": ["string", "null"]},
    "drifting_cameras": {"type": "array", "items": {"type": "string"}},
    "drift_score": {"type": ["number", "null"]},
    "score_delta": {"type": ["number", "null"]},
    "baseline_avg_score": {"type": ["number", "null"]}
  }
}
