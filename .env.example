# API
ANOMALYMATRIX_ENV=dev
LOG_LEVEL=INFO
ANOMALYMATRIX_INFERENCE_PROVIDER=stub
# stub | opencv_ready | patchcore
DATABASE_URL=
EDGE_ACQUISITION_URL=http://127.0.0.1:8091
OPCUA_GATEWAY_URL=http://127.0.0.1:8092
OPCUA_ENDPOINT=opc.tcp://localhost:4840/anomalymatrix/server/
OPCUA_PLC_STOP_ON_RED=true

# OPC-UA Gateway → API (PLC auto-trigger)
ANOMALYMATRIX_API_URL=http://127.0.0.1:8080
OPCUA_API_KEY=amx-key-operator
OPCUA_DEFAULT_CAMERA_ID=cam-01
OPCUA_DEFAULT_RECIPE_ID=recipe-default

# InfluxDB (metrics pipeline)
INFLUX_URL=
INFLUX_TOKEN=anomaly-token
INFLUX_ORG=anomalymatrix
INFLUX_BUCKET=inspection_metrics

# MinIO (heatmap / artifact storage)
MINIO_ENDPOINT=
MINIO_SECURE=false
MINIO_HEATMAP_BUCKET=heatmaps

# RBAC (v0.8) — false = Dev-Modus; JWT/Session/API-Key wenn enforce=true
RBAC_ENFORCE=false
JWT_SECRET=change-me-in-production
JWT_EXPIRE_SEC=28800
# Default login (JSON seed): admin-1 / changeme

# Camera (edge-acquisition v0.8)
CAMERA_DRIVER=synthetic
# synthetic | opencv | webcam | file
CAMERA_SOURCE=0
# Webcam index, image path, or file URI for OpenCV driver

# OPC-UA TLS (gateway)
OPCUA_SECURITY_ENABLED=false
OPCUA_CERT_DIR=opcua-gateway/certs

# Postgres
POSTGRES_DB=anomalymatrix
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=anomaly_pw

# InfluxDB
INFLUX_USERNAME=anomaly
INFLUX_PASSWORD=anomaly_pw
INFLUX_ORG=anomalymatrix
INFLUX_BUCKET=inspection_metrics
INFLUX_TOKEN=anomaly-token

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

LICENSE_SERVER_URL=
LICENSE_PRODUCT_ID=anomalymatrix
LICENSE_ADMIN_TOKEN=
LICENSE_STATE_FILE=backend/data/license_state.json
LICENSE_OFFLINE_GRACE_HOURS=24
LICENSE_VALIDATE_INTERVAL_SEC=60
LICENSE_ENFORCE=false
