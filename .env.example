# API
ANOMALYMATRIX_ENV=dev
LOG_LEVEL=INFO
ANOMALYMATRIX_INFERENCE_PROVIDER=stub
DATABASE_URL=
EDGE_ACQUISITION_URL=http://127.0.0.1:8091
OPCUA_GATEWAY_URL=http://127.0.0.1:8092
OPCUA_ENDPOINT=opc.tcp://localhost:4840

# InfluxDB (metrics pipeline)
INFLUX_URL=
INFLUX_TOKEN=anomaly-token
INFLUX_ORG=anomalymatrix
INFLUX_BUCKET=inspection_metrics

# MinIO (heatmap / artifact storage)
MINIO_ENDPOINT=
MINIO_SECURE=false
MINIO_HEATMAP_BUCKET=heatmaps

# Postgres
POSTGRES_DB=anomalymatrix
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=anomaly_pw

# InfluxDB
INFLUX_USERNAME=anomaly
INFLUX_PASSWORD=anomaly_pw
INFLUX_ORG=anomalymatrix
INFLUX_BUCKET=inspection_metrics
INFLUX_TOKEN=anomaly-token

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

LICENSE_SERVER_URL=
LICENSE_PRODUCT_ID=anomalymatrix
LICENSE_ADMIN_TOKEN=
LICENSE_STATE_FILE=backend/data/license_state.json
LICENSE_OFFLINE_GRACE_HOURS=24
LICENSE_VALIDATE_INTERVAL_SEC=60
LICENSE_ENFORCE=false
