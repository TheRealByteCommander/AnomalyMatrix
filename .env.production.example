# AnomalyMatrix — Production environment template
# Copy to .env.production and replace ALL placeholder secrets before deploy.
# NEVER commit .env.production

ANOMALYMATRIX_ENV=prod
LOG_LEVEL=INFO

# --- Security (required) ---
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET________________________________
RBAC_ENFORCE=true
LICENSE_ENFORCE=true
LICENSE_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
# Industrial offline licensing (product 2). Do not send customers to Stripe or licadmin.
# Leave LICENSE_SERVER_URL empty on air-gapped PCs.
LICENSE_SERVER_URL=
LICENSE_PRODUCT_ID=2
LICENSE_OFFLINE_ONLY=true
# Optional stable device id; default: hash of hostname + /etc/machine-id
# LICENSE_DEVICE_ID=
# Emergency only: allow AMX-* local keys
LICENSE_ALLOW_LOCAL_KEYS=false
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_VALIDATE_INTERVAL_SEC=300
SERVICE_AUTH_TOKEN=REPLACE_WITH_24PLUS_CHAR_SERVICE_TOKEN
COOKIE_SECURE=true

# --- CORS (HMI origin) ---
AMX_CORS_ORIGINS=https://anomalymatrix.example.com

# --- Database ---
DATABASE_URL=postgresql://anomaly:REPLACE_DB_PASSWORD@postgres:5432/anomalymatrix
POSTGRES_DB=anomalymatrix
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD

# --- Inference ---
ANOMALYMATRIX_INFERENCE_PROVIDER=patchcore

# --- Edge / OPC-UA ---
EDGE_ACQUISITION_URL=http://edge-acquisition:8091
OPCUA_GATEWAY_URL=http://opcua-gateway:8092
OPCUA_SECURITY_ENABLED=true
OPCUA_CERT_DIR=/app/certs
CAMERA_DRIVER=opencv
CAMERA_SOURCE=0
# USB 4K UVC (e.g. 32e4:6678): MJPG 3840x2160 @ 30fps (camera may do 60)
CAMERA_FOURCC=MJPG
CAMERA_WIDTH=3840
CAMERA_HEIGHT=2160
CAMERA_FPS=30
# GigE Vision: CAMERA_DRIVER=gige and overlay docker-compose.gige.yml
# CAMERA_SOURCE=<serial|DeviceUserID|GenTL-id>
# CAMERA_SOURCES_JSON={"cam-01":"22345678","cam-02":"CAM-SIDE"}
# CAMERA_EXPOSURE_MS=10
# CAMERA_GAIN_DB=0
# CAMERA_TRIGGER=freerun
# GIGE_BACKEND=auto
# GENICAM_GENTL64_PATH=/opt/gentl
OPCUA_API_KEY=REPLACE_OPCUA_API_KEY

# --- Observability ---
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=REPLACE_INFLUX_TOKEN
INFLUX_ORG=anomalymatrix
INFLUX_BUCKET=inspection_metrics
INFLUX_USERNAME=anomaly
INFLUX_PASSWORD=REPLACE_INFLUX_PASSWORD

# --- Object storage ---
MINIO_ENDPOINT=minio:9000
# Browser-facing artifact base (nginx proxies /artifacts/ → minio)
MINIO_PUBLIC_BASE=/artifacts
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_MINIO_PASSWORD
MINIO_SECURE=false
MINIO_ARCHIVE_BUCKET=archive-images

# --- MQTT (optional, additive to OPC-UA) ---
MQTT_ENABLED=false
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=anomalymatrix/eol/trigger
MQTT_QOS=1

# --- EOL station standard ---
AMX_STATION_ID=eol-station-01
AMX_LINE_ID=line-01
AMX_MAX_CAMERAS=4
AMX_RETENTION_TTL_DAYS=90
AMX_CAPTURE_WATCHDOG_SEC=30

# --- Admin bootstrap (first deploy) ---
AMX_ADMIN_PASSWORD=REPLACE_ADMIN_LOGIN_PASSWORD
